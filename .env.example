# TYO — environment template (NO real values here; copy to .env.local in the
# app repo). The public static site needs only SITE_URL / BASE_PATH.

# ---- public site (this repo) ------------------------------------------
SITE_URL=https://www.example.com
BASE_PATH=

# ---- URLs shared by all tiers -----------------------------------------
PUBLIC_SITE_URL=https://www.example.com
APP_URL=https://app.example.com
API_URL=https://api.example.com

# ---- Supabase (app repo) ----------------------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server / edge functions only — never in a client bundle

# ---- Stripe (test keys first; live keys only with owner enablement) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
PRO_MONTHLY_PRICE=19                  # display value; billing uses STRIPE_PRO_PRICE_ID

# ---- license API ------------------------------------------------------
LICENSE_KEY_PEPPER=                   # for sha256(key + pepper)
LICENSE_REFRESH_SECONDS=86400
LICENSE_GRACE_SECONDS=259200
LICENSE_RATE_LIMIT_PER_MIN=10

# ---- email provider (abstracted; empty = DB-only inquiries) ------------
EMAIL_PROVIDER=                       # resend | postmark | ''
EMAIL_API_KEY=
INQUIRY_NOTIFY_TO=                    # owner mailbox — DATA_REQUIRED

# ---- analytics (optional) ---------------------------------------------
PLAUSIBLE_DOMAIN=

# ---- feature flags ----------------------------------------------------
ENABLE_AUTH=false
ENABLE_PRO_BILLING=false
ENABLE_DOWNLOAD=false
ENABLE_LICENSE=false
ENABLE_PARTNER=false
ENABLE_CONTENT_AI=false
ENABLE_PERFORMANCE_UPLOAD=false
