dist/
node_modules/
.DS_Store
Thumbs.db
*.log

# Source art staging folder at the repo root only. The leading slash matters:
# a bare `images/` would also exclude public/assets/images/, which ships.
/images/

# dev-only canvas capture written by tools/serve.mjs
__shot.*

# Phase 12: trade-level forward/live data is PRIVATE. The repo is public, so
# raw statements and normalized trades must never be committed — only the
# aggregates in tools/forward-aggregates.json ship (see
# docs/FORWARD_SECURITY_PRIVACY.md).
data/forward/raw/
data/forward/normalized/
data/forward/exports/
data/forward/audit-log.jsonl

# python bytecode
__pycache__/

# MQL5 build artifacts (sources ship; binaries and compile logs do not)
mql5/**/*.ex5
mql5/*.log

# Phase 14: validation working data (manifests/windows/generated tester
# configs). Public aggregates ship via tools/validation-*.json and
# reports/validation/.
data/validation/

# Phase 15: research audit log + generated configs, and the holdout vault
# for raw data exports (never committed; the manifests in
# tools/research-protocol.json are the public record).
data/research/
data/holdout/
